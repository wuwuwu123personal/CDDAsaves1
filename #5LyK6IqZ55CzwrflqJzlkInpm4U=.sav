  "player_messages": { "messages": [ { "turn": 5655784, "message": "蝗虫跳了起来！", "count": 1, "type": 5 }, { "turn": 5655800, "message": "正在存档，可能需要点时间。", "count": 1, "type": 4 }, { "turn": 5655818, "message": "你放慢脚步，移动到营地椅", "count": 1, "type": 3 }, { "turn": 5655820, "message": "你放慢脚步，移动出营地椅", "count": 1, "type": 3 }, { "turn": 5655826, "message": "你放慢脚步，移动到<color_c_green>++</color><color_c_light_green>█</color> 车门", "count": 1, "type": 3 }, { "turn": 5655829, "message": "你放慢脚步，移动到<color_c_yellow>|\\</color><color_c_light_green>█</color> 可躺座椅", "count": 1, "type": 3 }, { "turn": 5655829, "message": "那里有一个载具控制器。", "count": 1, "type": 5 }, { "turn": 5655829, "message": "按 ^ 开始驾驶。", "count": 1, "type": 4 }, { "turn": 5655834, "message": "你关上了轿跑车的<color_c_green>++</color><color_c_light_green>█</color> 车门。", "count": 1, "type": 5 }, { "turn": 5655835, "message": "你放慢脚步，移动到<color_c_light_green>||</color><color_c_light_green>█</color> 后排座椅", "count": 1, "type": 3 }, { "turn": 5655837, "message": "蝗虫 击中了 腐朽丧尸！", "count": 3, "type": 5 }, { "turn": 5655837, "message": "腐朽丧尸 爬了起来！", "count": 1, "type": 5 }, { "turn": 5655839, "message": "蝗虫 击中了 腐朽丧尸！", "count": 1, "type": 5 }, { "turn": 5655840, "message": "你关上了轿跑车的<color_c_yellow>|\\</color><color_c_light_green>█</color> 车门。", "count": 1, "type": 5 }, { "turn": 5655840, "message": "蝗虫 击中了 腐朽丧尸！", "count": 1, "type": 5 }, { "turn": 5655841, "message": "算了。", "count": 1, "type": 5 }, { "turn": 5655841, "message": "你放慢脚步，移动到<color_c_yellow>|\\</color><color_c_light_green>█</color> 可躺座椅", "count": 1, "type": 3 }, { "turn": 5655841, "message": "那里有一个载具控制器。", "count": 1, "type": 5 }, { "turn": 5655841, "message": "按 ^ 开始驾驶。", "count": 1, "type": 4 }, { "turn": 5655847, "message": "你放慢脚步，移动到<color_c_green>++</color><color_c_light_green>█</color> 可躺座椅", "count": 1, "type": 3 }, { "turn": 5655848, "message": "蝗虫 击中了 腐朽丧尸！", "count": 2, "type": 5 }, { "turn": 5655848, "message": "腐朽丧尸 死了！", "count": 1, "type": 0 }, { "turn": 5655849, "mes