  "player_messages": { "messages": [ { "turn": 15251165, "message": "装甲运兵车 的 <color_c_green>++</color><color_c_light_green>█</color> 军用复合撞锤 撞到了 儿童丧尸！", "count": 2, "type": 3 }, { "turn": 15251165, "message": "装甲运兵车 的碾压 摧毁了一些东西！", "count": 2, "type": 1 }, { "turn": 15251165, "message": "儿童丧尸 死了！", "count": 1, "type": 0 }, { "turn": 15251165, "message": "杀死 儿童丧尸 让你异常懊悔。", "count": 1, "type": 1 }, { "turn": 15251165, "message": "儿童丧尸 死了！", "count": 1, "type": 0 }, { "turn": 15251166, "message": "你听见 咔嚓！", "count": 2, "type": 3 }, { "turn": 15251166, "message": "装甲运兵车 的碾压 损伤了 残破的儿童丧尸的尸体（新鲜） > 4 物品。", "count": 1, "type": 1 }, { "turn": 15251167, "message": "你听见东南方传来 刺耳哀嚎！", "count": 1, "type": 4 }, { "turn": 15251167, "message": "你听见 撞击声！", "count": 1, "type": 3 }, { "turn": 15251167, "message": "装甲运兵车 的 <color_c_green>++</color><color_c_light_green>█</color> 军用复合撞锤 撞到了 健壮丧尸，而且撞晕了它！", "count": 1, "type": 3 }, { "turn": 15251168, "message": "你听见 嘭！", "count": 1, "type": 3 }, { "turn": 15251168, "message": "你听见 咔嚓！", "count": 1, "type": 3 }, { "turn": 15251168, "message": "装甲运兵车 的 <color_c_light_green>||</color><color_c_light_green>█</color> 军用复合装甲板 撞到了 健壮丧尸！", "count": 1, "type": 3 }, { "turn": 15251168, "message": "装甲运兵车 的 <color_c_green>++</color><color_c_light_green>█</color> 军用复合装甲板 撞到了 健壮丧尸！", "count": 1, "type": 3 }, { "turn": 15251168, "message": "装甲运兵车 的 <color_c_light_red>|.</color><color_c_magenta>▅</color> 军用复合装甲板 撞到了 健壮丧尸，而且撞晕了它！", "count": 1, "type": 3 }, { "turn": 15251168, "message": "装甲运兵车 的 <color_c_light_green>||</color><color_c_light_green>█</color> 重型隔板 撞到了 健壮丧尸，而且撞晕了它！", "count": 1, "type": 3 }, { "turn": 15251168, "message": "健壮丧尸 死了！", "count": 1, "type": 0 }, { "turn": 15251169, "message": "你听见 撞击声！", "count": 1, "type": 3 }, { "turn": 15251169, "message": "你听见 咔嚓！", "count": 4, "type": 3 }, { "turn": 15251172, "message": "装甲运兵车 的碾压 摧毁了 石头！", "count": 1, "type": 1 }, { "turn": 15251268, "message": "你听见 嗡~", "count": 1, "type": 4 }, { "turn": 152513