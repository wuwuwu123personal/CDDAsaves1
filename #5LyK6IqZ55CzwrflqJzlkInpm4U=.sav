rn": 7065357, "message": "棕色雏鸟 死了！", "count": 1, "type": 0 }, { "turn": 7065418, "message": "你听见 呼呼！", "count": 1, "type": 4 }, { "turn": 7065430, "message": "你关闭引擎，松开了控制器。", "count": 1, "type": 5 }, { "turn": 7065430, "message": "你打开了 双门轿跑车 的 <color_c_light_green>||</color><color_c_light_green>█</color> 车门。", "count": 1, "type": 5 }, { "turn": 7065431, "message": "你放慢脚步，移动到<color_c_light_green>||</color><color_c_light_green>█</color> 车门", "count": 1, "type": 3 }, { "turn": 7065437, "message": "你放慢脚步，移动出<color_c_light_green>||</color><color_c_light_green>█</color> 车门", "count": 1, "type": 3 }, { "turn": 7065441, "message": "你脱下你的 <color_c_green>++</color> 直排轮滑鞋。", "count": 1, "type": 5 }, { "turn": 7065441, "message": "你有带安装槽位的装备，如果希望安装组件，请不要在那些部位穿硬甲。", "count": 1, "type": 3 }, { "turn": 7065441, "message": "你穿上 <color_c_green>++</color> 登山靴。", "count": 1, "type": 5 }, { "turn": 7065441, "message": "你有带安装槽位的装备，如果希望安装组件，请不要在那些部位穿硬甲。", "count": 1, "type": 3 }, { "turn": 7065451, "message": "你拾取：1 工兵铲", "count": 1, "type": 5 }, { "turn": 7065454, "message": "你将 长尖木棍 放进 双门轿跑车 的 轿车后备箱。", "count": 1, "type": 5 }, { "turn": 7065454, "message": "你手持了 <color_c_green>++</color> 旅行箱 > 7 物品。", "count": 1, "type": 5 }, { "turn": 7065500, "message": "正在存档，可能需要点时间。", "count": 1, "type": 4 }, { "turn": 7065502, "message": "附近没有可以拾取的物品。", "count": 1, "type": 5 }, { "turn": 7066707, "message": "你 建造完成了：挖浅坑。", "count": 1, "type": 4 }, { "turn": 7066709, "message": "你在这里看到 42 泥土 和 1 石头。", "count": 1, "type": 5 }, { "turn": 7066718, "message": "附近没有可以拾取的物品。", "count": 1, "type": 5 }, { "turn": 7066736, "message": "附近没有可以拾取的物品。", "count": 1, "type": 5 }, { "turn": 7067961, "message": "你觉得自己疲惫不堪，持续进行这种强度的活动会变慢。", "count": 1, "type": 1 }, { "turn": 7068535, "message": "你 建造完成了：收集黏土。", "count": 1, "type": 4 }, { "turn": 7068535, "message": "你收获了一些黏土。", "count": 1, "type": 5 }, { "turn": 7069800, "message": "你有点累了，结果速度变慢了。", "count": 1, "type": 4 }, { "turn": 7070335, "message": "你 建造完成了：收集黏